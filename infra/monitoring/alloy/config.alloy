// 온박스 수집 설정. 지표와 로그를 모아 Grafana Cloud로 보낸다.
// 자격증명은 .env로 주입한다(env-from-ssm.sh가 SSM에서 생성).

// ---------------------------------------------------------------------------
// 전송 (박스 밖)
// ---------------------------------------------------------------------------

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROM_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		// Loki는 Prometheus와 user ID가 다르다. 토큰은 같은 것을 쓴다.
		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}
}

// ---------------------------------------------------------------------------
// 지표
// ---------------------------------------------------------------------------

// 앱. 배포 중에는 잠깐 스크레이프가 실패하는데(이전 컨테이너를 멈추고 새로 띄우므로)
// 대시보드에 짧은 공백으로 보이는 게 정상이다.
prometheus.scrape "app" {
	targets = [{
		__address__ = "127.0.0.1:8080",
		job         = "muffin-backend",
		instance    = "muffin-ec2",
	}]

	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// 호스트. t3.small 2GB에서 앱이 굶는지 보려면 필요하다.
// 컨테이너 안에서 /proc을 읽으면 컨테이너 기준 값이 나오므로 마운트한 호스트 루트를 가리킨다.
prometheus.exporter.unix "host" {
	rootfs_path = "/rootfs"
	procfs_path = "/rootfs/proc"
	sysfs_path  = "/rootfs/sys"
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// RDS(MySQL 내부 상태). 인스턴스 CPU/메모리/IOPS는 CloudWatch가 따로 답한다.
prometheus.scrape "mysql" {
	targets = [{
		__address__ = "127.0.0.1:9104",
		job         = "muffin-rds",
		instance    = "muffin-db",
	}]

	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// RDS 인스턴스 자체의 CPU/메모리/IOPS. mysqld-exporter는 MySQL이 들고 있는 상태값만 보고
// RDS 안쪽 리눅스는 보지 못한다.
//
// 박스에서 긁는 것은 EC2 인스턴스 역할로 인증하기 위해서다(AWS 키를 외부에 두지 않는다).
// 5분 간격은 GetMetricData가 호출당 과금이고 RDS 기본 지표가 60초 해상도라, 더 자주 긁어도
// 같은 값에 요금만 늘기 때문이다.
prometheus.exporter.cloudwatch "rds" {
	sts_region = "ap-northeast-2"

	discovery {
		type        = "AWS/RDS"
		regions     = ["ap-northeast-2"]
		// 태그로 찾는다. 인스턴스 식별자를 적으면 DB를 재생성할 때 조용히 빈다.
		search_tags = {
			Project = "muffin",
		}

		// CloudWatch는 같은 값을 여러 차원 조합으로 발행한다. 이 설정이 없으면 인스턴스가
		// 하나뿐인데도 지표 하나가 시계열 4개로 들어온다(패널 4분할, 알림 4중, 호출량 4배).
		dimension_name_requirements = ["DBInstanceIdentifier"]

		metric {
			name       = "CPUUtilization"
			statistics = ["Average"]
			period     = "5m"
		}

		// 낮은 값 자체는 이상이 아니다. InnoDB가 버퍼풀(1GiB의 약 3/4)을 미리 잡고 돌려주지
		// 않으므로 낮게 정착하는 게 정상이다. 디스크 여유처럼 0으로 수렴하는 값이 아니라
		// 이것만으로는 위험을 판단할 수 없고, 아래 SwapUsage와 함께 봐야 한다.
		metric {
			name       = "FreeableMemory"
			statistics = ["Average"]
			period     = "5m"
		}

		// 메모리 압박의 실제 신호. 스왑을 쓰기 시작한 시점부터 쿼리가 느려진다.
		metric {
			name       = "SwapUsage"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "FreeStorageSpace"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "DatabaseConnections"
			statistics = ["Maximum"]
			period     = "5m"
		}

		metric {
			name       = "ReadIOPS"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "WriteIOPS"
			statistics = ["Average"]
			period     = "5m"
		}

		// 크레딧이 바닥나면 t3 계열은 기준선(vCPU의 10%)으로 묶여 전체가 느려진다.
		// 코드를 봐도 원인이 보이지 않는 종류의 지연이라 지표로 남긴다.
		metric {
			name       = "CPUCreditBalance"
			statistics = ["Average"]
			period     = "5m"
		}
	}
}

// exporter가 붙이는 instance는 이 컴포넌트 설정의 해시다. 위 cloudwatch 블록을 고칠 때마다
// 값이 바뀌어 같은 지표가 새 시계열로 갈라지므로, 고정값으로 덮는다(mysql 타깃과 같은 방식).
prometheus.relabel "cloudwatch" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		action       = "replace"
		target_label = "instance"
		replacement  = "muffin-db"
	}
}

prometheus.scrape "cloudwatch" {
	targets         = prometheus.exporter.cloudwatch.rds.targets
	scrape_interval = "5m"
	forward_to      = [prometheus.relabel.cloudwatch.receiver]
}

// ---------------------------------------------------------------------------
// 로그
// ---------------------------------------------------------------------------

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// 도커가 주는 이름은 "/muffin" 형태라 앞의 슬래시를 떼어낸다.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
		replacement   = "$1"
	}

	// 배포 중 이전 컨테이너가 잠시 "muffin-prev"로 남는다. 접미사를 벗겨 service 라벨
	// 하나로 모아야 앱 로그가 두 갈래로 갈라지지 않는다.
	rule {
		source_labels = ["container"]
		regex         = "(.*?)(-prev)?"
		target_label  = "service"
		replacement   = "$1"
	}

	// 수집기 자신의 로그는 앱 로그를 덮는 노이즈다. 필요하면 docker logs로 직접 본다.
	rule {
		source_labels = ["service"]
		regex         = "muffin-alloy|muffin-mysqld-exporter"
		action        = "drop"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.app.receiver]
}

// 운영 로그는 JSON 한 줄이라(관측 0단계에서 구조화) level과 domain을 필드로 뽑을 수 있다.
// 라벨은 값의 종류가 유한한 것만 올린다. 고유값을 라벨에 넣으면 시계열이 무한히 늘어난다.
loki.process "app" {
	stage.json {
		expressions = {
			level  = "level",
			domain = "domain",
		}
	}

	stage.labels {
		values = {
			level  = "",
			domain = "",
		}
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}
