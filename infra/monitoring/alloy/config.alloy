// 온박스 수집 설정. 지표와 로그를 모아 Grafana Cloud로 보낸다.
// 자격증명은 .env로 주입한다(env-from-ssm.sh가 SSM에서 생성).

// ---------------------------------------------------------------------------
// 전송 (박스 밖)
// ---------------------------------------------------------------------------

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROM_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		// Loki는 Prometheus와 user ID가 다르다. 토큰은 같은 것을 쓴다.
		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}
}

// ---------------------------------------------------------------------------
// 지표
// ---------------------------------------------------------------------------

// 앱. 배포 중에는 잠깐 스크레이프가 실패하는데(이전 컨테이너를 멈추고 새로 띄우므로)
// 대시보드에 짧은 공백으로 보이는 게 정상이다.
prometheus.scrape "app" {
	targets = [{
		__address__ = "127.0.0.1:8080",
		job         = "muffin-backend",
		instance    = "muffin-ec2",
	}]

	metrics_path    = "/actuator/prometheus"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// 호스트. t3.small 2GB에서 앱이 굶는지 보려면 필요하다.
// 컨테이너 안에서 /proc을 읽으면 컨테이너 기준 값이 나오므로 마운트한 호스트 루트를 가리킨다.
prometheus.exporter.unix "host" {
	rootfs_path = "/rootfs"
	procfs_path = "/rootfs/proc"
	sysfs_path  = "/rootfs/sys"
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// RDS(MySQL 내부 상태). 인스턴스 CPU/메모리/IOPS는 CloudWatch가 따로 답한다.
prometheus.scrape "mysql" {
	targets = [{
		__address__ = "127.0.0.1:9104",
		job         = "muffin-rds",
		instance    = "muffin-db",
	}]

	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// RDS 인스턴스 자체의 CPU/메모리/IOPS. mysqld-exporter는 MySQL이 들고 있는 상태값만 보고
// RDS 안쪽 리눅스는 보지 못한다. "쿼리가 느린 게 DB 부하 때문인가"는 이 지표라야 답이 된다.
//
// Grafana Cloud의 CloudWatch 데이터소스를 쓰지 않고 여기서 긁는 이유: 그쪽은 만료 없는 AWS
// 액세스 키를 외부 서비스에 보관해야 한다. 박스에서 긁으면 EC2 인스턴스 역할로 인증하므로
// 자격증명이 AWS 밖으로 나가지 않고, 키 교체를 사람이 기억할 필요도 없다.
//
// 5분 간격인 이유는 비용이다. GetMetricData는 호출당 과금이고 RDS 기본 지표 자체가 60초
// 해상도라, 더 자주 긁어도 같은 값을 다시 받으면서 요금만 늘어난다.
prometheus.exporter.cloudwatch "rds" {
	sts_region = "ap-northeast-2"

	discovery {
		type        = "AWS/RDS"
		regions     = ["ap-northeast-2"]
		// 태그로 찾는다. 인스턴스 식별자를 적으면 DB를 재생성할 때 조용히 빈다.
		search_tags = {
			Project = "muffin",
		}

		// CloudWatch의 AWS/RDS 네임스페이스는 같은 값을 여러 차원 조합으로 함께 발행한다
		// (DBInstanceIdentifier, DatabaseClass, EngineName 등). 이 설정이 없으면 인스턴스가
		// 하나뿐인데도 지표 하나가 시계열 4개로 들어와, stat 패널이 같은 값을 4분할로 보여주고
		// 알림 룰은 인스턴스 하나에 알림 4개를 만든다. GetMetricData 호출량도 4배가 된다.
		dimension_name_requirements = ["DBInstanceIdentifier"]

		metric {
			name       = "CPUUtilization"
			statistics = ["Average"]
			period     = "5m"
		}

		// 이 값이 300MB 아래로 내려가지 않는지가 performance_schema를 켤 수 있는지의 판단 근거다
		// (TODOLOG 2026-08-05 보류 항목).
		metric {
			name       = "FreeableMemory"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "FreeStorageSpace"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "DatabaseConnections"
			statistics = ["Maximum"]
			period     = "5m"
		}

		metric {
			name       = "ReadIOPS"
			statistics = ["Average"]
			period     = "5m"
		}

		metric {
			name       = "WriteIOPS"
			statistics = ["Average"]
			period     = "5m"
		}

		// CPU 크레딧이 바닥나면 t3 계열은 기준선(vCPU의 10%)으로 묶인다. 배치가 느려지는
		// 원인 중 코드를 아무리 봐도 안 보이는 종류라 지표로 남긴다.
		//
		// 원래 BurstBalance(gp2 볼륨의 IO 크레딧)를 넣었는데 값이 오지 않았다.
		// 우리 스토리지는 gp3라 CloudWatch가 그 지표를 발행하지 않는다(gp2 전용이다).
		// gp3는 IOPS가 크레딧이 아니라 고정 할당이라 바닥날 잔량이라는 개념 자체가 없다.
		// t3 인스턴스에서 실제로 바닥나는 것은 CPU 크레딧이므로 그걸로 바꿨다.
		metric {
			name       = "CPUCreditBalance"
			statistics = ["Average"]
			period     = "5m"
		}
	}
}

prometheus.scrape "cloudwatch" {
	targets         = prometheus.exporter.cloudwatch.rds.targets
	scrape_interval = "5m"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ---------------------------------------------------------------------------
// 로그
// ---------------------------------------------------------------------------

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// 도커가 주는 이름은 "/muffin" 형태라 앞의 슬래시를 떼어낸다.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
		replacement   = "$1"
	}

	// 배포 중에는 이전 컨테이너가 잠시 "muffin-prev"로 남는다. 이름을 그대로 라벨로 쓰면
	// 배포할 때마다 같은 앱의 로그가 두 갈래로 갈라져 "앱 로그만 보기"가 반쪽이 된다.
	// 접미사를 벗겨 service 라벨 하나로 모은다.
	rule {
		source_labels = ["container"]
		regex         = "(.*?)(-prev)?"
		target_label  = "service"
		replacement   = "$1"
	}

	// 수집기 자신의 로그는 앱 로그를 덮는 노이즈다. 필요하면 docker logs로 직접 본다.
	rule {
		source_labels = ["service"]
		regex         = "muffin-alloy|muffin-mysqld-exporter"
		action        = "drop"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.app.receiver]
}

// 운영 로그는 JSON 한 줄이라(관측 0단계에서 구조화) level과 domain을 필드로 뽑을 수 있다.
// 라벨은 값의 종류가 유한한 것만 올린다. 고유값을 라벨에 넣으면 시계열이 무한히 늘어난다.
loki.process "app" {
	stage.json {
		expressions = {
			level  = "level",
			domain = "domain",
		}
	}

	stage.labels {
		values = {
			level  = "",
			domain = "",
		}
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}
