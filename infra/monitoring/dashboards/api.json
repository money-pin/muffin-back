{
  "uid": "muffin-api",
  "title": "Muffin / API·앱",
  "description": "HTTP 트래픽과 JVM·호스트 상태. p95는 히스토그램이 아니라 SLO 경계 14개(10ms~5s)로 근사한 값이다. 정밀한 분위수가 필요하면 부하테스트용 로컬 스택을 쓴다.",
  "tags": [
    "muffin",
    "api"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prom",
        "label": "지표",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "로그",
        "query": "loki",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "요약",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "초당 요청 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "성공률",
      "description": "outcome=SUCCESS 비율. 401이 섞여 내려가는 것은 로그인 만료가 정상 동작한 경우일 수 있으므로 상태코드 패널과 함께 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"muffin\",outcome=\"SUCCESS\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))",
          "legendFormat": "성공률"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx (1시간)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"muffin\",outcome=\"SERVER_ERROR\"}[1h])) or vector(0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "에러 로그 (1시간)",
      "description": "logback ERROR 카운터. 5xx가 없어도 여기가 오르면 배치나 비동기 경로에서 터지고 있다는 뜻이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(increase(logback_events_total{application=\"muffin\",level=\"error\"}[1h])) or vector(0)",
          "legendFormat": "ERROR"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "앱 가동 시간",
      "description": "짧으면 방금 재배포됐거나 죽었다 살아난 것이다. 배치 게이지가 0인 이유를 여기서 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "process_uptime_seconds{application=\"muffin\"}",
          "legendFormat": "가동"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "수집 상태",
      "description": "0이면 Alloy가 앱을 못 긁고 있다. 배포 중 잠깐 0이 되는 것은 정상이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "끊김",
                  "color": "red"
                },
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up{job=\"muffin-backend\"}",
          "legendFormat": "앱",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "트래픽",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "전체 RPS (초당 요청 수)",
      "description": "OPTIONS(CORS preflight)가 전체의 상당수를 차지한다. 브라우저가 요청마다 preflight를 보내고 캐시하지 않아서인데, 실제 사용량을 보려면 method별 선에서 OPTIONS를 빼고 읽는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "전체",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "{{method}}",
          "expr": "sum by (method) (rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "호출 많은 엔드포인트 Top 10 (24시간)",
      "description": "실행 횟수 순위. 오른쪽 p95 패널과 같이 보면 '느린데 자주 불리는 엔드포인트'가 드러난다. 한 번 느린 것보다 훨씬 비싸므로 그게 최적화 1순위다. OPTIONS(CORS preflight)가 상위에 오는 것은 정상인데, 실제 사용량이 아니라 브라우저가 요청마다 보내는 사전 확인이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "displayName": "${__field.labels.method} ${__field.labels.uri}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 12,
        "sizing": "auto",
        "text": {
          "titleSize": 11,
          "valueSize": 13
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false,
          "expr": "topk(10, sum by (uri, method) (increase(http_server_requests_seconds_count{application=\"muffin\"}[24h])))"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "엔드포인트별 RPS Top 10",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "{{method}} {{uri}}",
          "expr": "topk(10, sum by (uri, method) (rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "상태코드별 요청",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "처리량 · 포화점",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "동시 처리 수 · TPS · 평균 응답시간",
      "description": "Little's Law(L = λ × W)의 세 항을 같이 둔 패널이다. 동시 처리 수(L)는 Micrometer가 재는 실제 in-flight 요청 수이고, 'TPS x 평균응답시간'은 같은 값을 법칙으로 유도한 것이다. 두 선이 겹치면 측정이 서로 모순되지 않는다는 뜻이다. 어긋나면 둘 중 하나를 의심한다.\n\n포화는 이렇게 읽는다: 동시 처리 수가 계속 오르는데 TPS가 평평해지면 그 지점이 한계다. 그 뒤로는 늘어난 부하가 처리량이 아니라 응답시간으로만 간다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "평균 응답시간"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TPS x 평균응답시간 (법칙 유도)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "동시 처리 수 (실측)",
          "expr": "sum(http_server_requests_active_seconds_gcount{application=\"muffin\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "TPS",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "평균 응답시간",
          "expr": "sum(rate(http_server_requests_seconds_sum{application=\"muffin\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"muffin\"}[$__rate_interval])), 0.0001)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "legendFormat": "TPS x 평균응답시간 (법칙 유도)",
          "expr": "sum(rate(http_server_requests_seconds_sum{application=\"muffin\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 19,
      "type": "xychart",
      "title": "TPS 곡선 (동시 처리 수 대비 처리량)",
