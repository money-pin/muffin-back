root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

# Windows 배치 파일은 CRLF 유지 (.gitattributes와 일치)
[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false